APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD are injected by Wasmer at runtime.
# For local dev, use SQLite below or set these manually in .env (not committed).

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- JWT auth (tymon/jwt-auth) ------------------------------------------------
# Required. Generate with: php artisan jwt:secret
JWT_SECRET=
# Optional overrides (defaults come from config/jwt.php):
#JWT_TTL=60
#JWT_REFRESH_TTL=20160
#JWT_BLACKLIST_ENABLED=true

# --- Firebase (kreait/laravel-firebase) ----------------------------------------
# Absolute path to the Admin SDK service-account JSON from
# Firebase console -> Project settings -> Service accounts -> Your project.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json

# --- Mailgun (default mailer: MAIL_MAILER=mailgun) ------------------------------
# Sandbox domain + API key from mailgun.com -> Sending -> SMTP & API
MAILGUN_DOMAIN=sandboxYOUR-SANDBOX-ID.mailgun.org
MAILGUN_SECRET=YOUR-MAILGUN-SECRET-HERE

# --- Wasmer Edge deployment ----------------------------------------------------
# On Wasmer Edge, use capabilities.database in app.yaml.
# Wasmer auto-provisions MySQL and provides env vars:
#   DB_HOST, DB_PORT, DB_NAME, DB_USERNAME, DB_PASSWORD
# Laravel falls back from DB_NAME to DB_DATABASE, so no extra mapping is needed.
#
# NEVER add DB_* to the app environment or secret store on Wasmer: app-level
# variables shadow the injected ones, so DB_HOST becomes empty and the app
# fails with SQLSTATE[HY000] [2002] Operation not permitted. Only secrets the
# capability does not provide (APP_KEY, JWT_SECRET, ...) belong there.
#
# Local dev only — never commit real values:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# --- API docs (l5-swagger) -------------------------------------------------------
# true = regenerate storage/api-docs/api-docs.json on every request (dev mode)
L5_SWAGGER_GENERATE_ALWAYS=true
# Keep the JWT auth token filled in the Swagger UI across page loads
L5_SWAGGER_UI_PERSIST_AUTHORIZATION=true
