<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay (merged on top of the main manifest for debug
  builds only). Allows cleartext HTTP so the debug build can reach the local
  backend at http://10.0.2.2:8000/api/ (emulator host machine). Release builds
  keep the platform default (cleartext blocked) and talk HTTPS only.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
